# anthropic
ANTHROPIC_API_KEY=sk-ant-...

# flask
FLASK_ENV=development
FLASK_SECRET_KEY=            # generate w secrets.token_hex(32)
PORT=5000

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://margin-app.example.com